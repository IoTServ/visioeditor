<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>$(VISIOEDITOR_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Mac App Store / Launchpad category: diagram / vector graphics editor. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>
	<!-- Uses only HTTPS/system crypto (TLS) and local loopback; no custom
	     encryption that requires export-compliance documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  No NS*UsageDescription keys: file access goes through Open/Save panels
	  and security-scoped bookmarks (user-selected.read-write). Agent live
	  preview binds 127.0.0.1 only (no local-network / Bonjour prompt).
	-->
	<!--
	  Bind to the system / Microsoft Visio UTIs that Launch Services already
	  assigns to these extensions (see `mdls` / UTType):
	    .vsd  → com.microsoft.visio.drawing
	    .vsdx → com.microsoft.visio.drawing.opc
	    .vsdm → com.microsoft.visio.drawing.macro-enabled
	    .vstx → com.microsoft.visio.template.opc
	    .vstm → com.microsoft.visio.template.macro-enabled
	    .vssx → com.microsoft.visio.stencil.opc
	    .vssm → com.microsoft.visio.stencil.macro-enabled
	  Claiming the wrong UTI (e.g. zip-shaped com.microsoft.visio.drawing for
	  .vsdx) means Finder never offers this app for real .vsdx files.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Visio Drawing</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.visio.drawing.opc</string>
				<string>com.microsoft.visio.drawing.macro-enabled</string>
				<string>com.microsoft.visio.template.opc</string>
				<string>com.microsoft.visio.template.macro-enabled</string>
				<string>com.microsoft.visio.stencil.opc</string>
				<string>com.microsoft.visio.stencil.macro-enabled</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>vsdx</string>
				<string>vsdm</string>
				<string>vstx</string>
				<string>vstm</string>
				<string>vssx</string>
				<string>vssm</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Visio Binary Drawing</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.visio.drawing</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>vsd</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>draw.io Diagram</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.jgraph.drawio.diagram</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>drawio</string>
			</array>
		</dict>
	</array>
	<!-- Fallbacks when the host OS has not yet registered Microsoft's UTIs. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.jgraph.drawio.diagram</string>
			<key>UTTypeDescription</key>
			<string>draw.io Diagram</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>drawio</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.jgraph.mxfile</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.drawing</string>
			<key>UTTypeDescription</key>
			<string>Visio Binary Drawing</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vsd</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.visio</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.drawing.opc</string>
			<key>UTTypeDescription</key>
			<string>Visio Drawing</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vsdx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ms-visio.drawing</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.drawing.macro-enabled</string>
			<key>UTTypeDescription</key>
			<string>Visio Drawing (macro-enabled)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vsdm</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ms-visio.drawing.macroEnabled.12</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.template.opc</string>
			<key>UTTypeDescription</key>
			<string>Visio Template</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vstx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ms-visio.template</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.template.macro-enabled</string>
			<key>UTTypeDescription</key>
			<string>Visio Template (macro-enabled)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vstm</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ms-visio.template.macroEnabled.12</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.stencil.opc</string>
			<key>UTTypeDescription</key>
			<string>Visio Stencil</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vssx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ms-visio.stencil</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.stencil.macro-enabled</string>
			<key>UTTypeDescription</key>
			<string>Visio Stencil (macro-enabled)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vssm</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ms-visio.stencil.macroEnabled.12</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
