[Desktop Entry]
Type=Application
Version=1.0
Name=Editor for Visio Diagrams
GenericName=Visio Diagram Editor
Comment=Open and edit Visio and draw.io diagrams
# `visioeditor` must be on PATH (or use an absolute path to the built binary).
Exec=visioeditor %f
Icon=visioeditor
Terminal=false
Categories=Graphics;Office;VectorGraphics;
StartupNotify=true
MimeType=application/vnd.ms-visio.drawing;application/vnd.ms-visio.drawing.macroEnabled.12;application/vnd.ms-visio.template;application/vnd.ms-visio.template.macroEnabled.12;application/vnd.ms-visio.stencil;application/vnd.ms-visio.stencil.macroEnabled.12;application/vnd.visio;application/vnd.jgraph.mxfile;
