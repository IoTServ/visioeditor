<?xml version="1.0" encoding="UTF-8"?>
<!--
  shared-mime-info definition for Microsoft Visio drawings.
  - .vsdx/.vsdm/.vstx/.vstm/.vssx/.vssm are OPC (ZIP) packages
  - .vsd/.vss/.vst are legacy binary (OLE2) → application/vnd.visio
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.visio">
    <comment>Visio Binary Drawing, Stencil, or Template</comment>
    <glob pattern="*.vsd"/>
    <glob pattern="*.vss"/>
    <glob pattern="*.vst"/>
  </mime-type>
  <mime-type type="application/vnd.ms-visio.drawing">
    <comment>Visio Drawing</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.vsdx"/>
  </mime-type>
  <mime-type type="application/vnd.ms-visio.drawing.macroEnabled.12">
    <comment>Visio Macro-Enabled Drawing</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.vsdm"/>
  </mime-type>
  <mime-type type="application/vnd.ms-visio.template">
    <comment>Visio Template</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.vstx"/>
  </mime-type>
  <mime-type type="application/vnd.ms-visio.template.macroEnabled.12">
    <comment>Visio Macro-Enabled Template</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.vstm"/>
  </mime-type>
  <mime-type type="application/vnd.ms-visio.stencil">
    <comment>Visio Stencil</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.vssx"/>
  </mime-type>
  <mime-type type="application/vnd.ms-visio.stencil.macroEnabled.12">
    <comment>Visio Macro-Enabled Stencil</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.vssm"/>
  </mime-type>
  <mime-type type="application/vnd.jgraph.mxfile">
    <comment>draw.io Diagram</comment>
    <sub-class-of type="application/xml"/>
    <glob pattern="*.drawio"/>
  </mime-type>
</mime-info>
