<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Loopback WebSocket for optional "Agent live preview" (HttpServer.bind).
         File open/save uses the system document picker (SAF) and does not need
         READ/WRITE_EXTERNAL_STORAGE. Debug/profile also declare INTERNET for
         Flutter tooling (hot reload / observatory). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="Visio Vsdx Editor"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Open Visio drawings handed over by another app / file manager
                 that already knows the MIME type.
                 .vsd/.vss/.vst/.vsx/.vtx → application/vnd.visio
                 .vdx → application/vnd.ms-visio.viewer
                 .vsdx → application/vnd.ms-visio.drawing (+ macro/template/stencil) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:mimeType="application/vnd.visio"/>
                <data android:mimeType="application/vnd.ms-visio.viewer"/>
                <data android:mimeType="application/vnd.ms-visio.drawing"/>
                <data android:mimeType="application/vnd.ms-visio.drawing.macroEnabled.12"/>
                <!-- Compatibility with providers that omit the Office `.12` suffix. -->
                <data android:mimeType="application/vnd.ms-visio.drawing.macroEnabled"/>
                <data android:mimeType="application/vnd.ms-visio.template"/>
                <data android:mimeType="application/vnd.ms-visio.template.macroEnabled.12"/>
                <data android:mimeType="application/vnd.ms-visio.template.macroEnabled"/>
                <data android:mimeType="application/vnd.ms-visio.stencil"/>
                <data android:mimeType="application/vnd.ms-visio.stencil.macroEnabled.12"/>
                <data android:mimeType="application/vnd.ms-visio.stencil.macroEnabled"/>
                <data android:mimeType="application/vnd.jgraph.mxfile"/>
            </intent-filter>
            <!-- Fall back to matching by file extension (content/file URIs whose
                 MIME is generic). pathPattern matching is best-effort on
                 Android; the source app must still grant read access. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:host="*"/>
                <data android:mimeType="*/*"/>
                <data android:pathPattern=".*\\.vsd"/>
                <data android:pathPattern=".*\\.vss"/>
                <data android:pathPattern=".*\\.vst"/>
                <data android:pathPattern=".*\\.vdx"/>
                <data android:pathPattern=".*\\.vsx"/>
                <data android:pathPattern=".*\\.vtx"/>
                <data android:pathPattern=".*\\.vsdx"/>
                <data android:pathPattern=".*\\.vsdm"/>
                <data android:pathPattern=".*\\.vstx"/>
                <data android:pathPattern=".*\\.vstm"/>
                <data android:pathPattern=".*\\.vssx"/>
                <data android:pathPattern=".*\\.vssm"/>
                <data android:pathPattern=".*\\.drawio"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
