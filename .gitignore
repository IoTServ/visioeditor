# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/packages/*/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Third-party reference clones — downloaded for reference only, not committed.
# See third_party/README.md for the pinned URLs / commits / licenses.
/third_party/*
!/third_party/README.md

# Compat-check outputs rewritten on every run of test/_edraw_compare.dart.
/assets/examples/edraw_compat_demo.vsdx
/assets/examples/Untitled333_edraw_fixed.vsdx
