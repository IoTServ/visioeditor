<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(VISIOEDITOR_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Editor for Visio Diagrams</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Uses only HTTPS/system crypto (TLS) and local loopback; no custom
	     encryption that requires export-compliance documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  Purpose strings required by App Store (ITMS-90683). Open/save primarily
	  use the system document picker; file_picker still links Photo Library /
	  Camera (and may touch photo location metadata), so these keys are required
	  even when those paths are unused. App Store category is set in App Store
	  Connect (Graphics & Design / Productivity) — iOS has no
	  LSApplicationCategoryType.
	-->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Editor for Visio Diagrams needs access to your photo library so you can choose photos and images to insert into diagrams.</string>
	<key>NSCameraUsageDescription</key>
	<string>Editor for Visio Diagrams needs camera access so you can capture a photo and insert it into a diagram.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Editor for Visio Diagrams may read location metadata from photos you insert into diagrams. It does not track your location.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Lets UIDocumentPicker export (Save / Export) present reliably on iPad. -->
	<key>UISupportsDocumentBrowser</key>
	<true/>
	<!--
	  Match system Visio UTIs (.vsdx → drawing.opc, .vsd → drawing).
	  See macos/Runner/Info.plist for the full rationale.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Visio Drawing</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.visio.drawing.opc</string>
				<string>com.microsoft.visio.drawing.macro-enabled</string>
				<string>com.microsoft.visio.template.opc</string>
				<string>com.microsoft.visio.template.macro-enabled</string>
				<string>com.microsoft.visio.stencil.opc</string>
				<string>com.microsoft.visio.stencil.macro-enabled</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>vsdx</string>
				<string>vsdm</string>
				<string>vstx</string>
				<string>vstm</string>
				<string>vssx</string>
				<string>vssm</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Visio Binary Drawing</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.visio.drawing</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>vsd</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.drawing</string>
			<key>UTTypeDescription</key>
			<string>Visio Binary Drawing</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vsd</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.visio</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.drawing.opc</string>
			<key>UTTypeDescription</key>
			<string>Visio Drawing</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vsdx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ms-visio.drawing</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.drawing.macro-enabled</string>
			<key>UTTypeDescription</key>
			<string>Visio Drawing (macro-enabled)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vsdm</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ms-visio.drawing.macroEnabled.12</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.template.opc</string>
			<key>UTTypeDescription</key>
			<string>Visio Template</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vstx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ms-visio.template</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.template.macro-enabled</string>
			<key>UTTypeDescription</key>
			<string>Visio Template (macro-enabled)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vstm</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ms-visio.template.macroEnabled.12</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.stencil.opc</string>
			<key>UTTypeDescription</key>
			<string>Visio Stencil</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vssx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ms-visio.stencil</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.microsoft.visio.stencil.macro-enabled</string>
			<key>UTTypeDescription</key>
			<string>Visio Stencil (macro-enabled)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vssm</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ms-visio.stencil.macroEnabled.12</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
