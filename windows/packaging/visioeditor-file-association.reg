Windows Registry Editor Version 5.00

; File association for Flowcharts Editor (per-user, HKCU).
; BEFORE IMPORTING: replace every C:\\Path\\To\\visioeditor.exe below with the
; real path to the built executable (e.g. the Release runner or install dir).
; Double-clicking a supported Visio file launches the app with its path as argv[1].

[HKEY_CURRENT_USER\Software\Classes\VisioEditor.Drawing]
@="Visio Drawing"

[HKEY_CURRENT_USER\Software\Classes\VisioEditor.Drawing\DefaultIcon]
@="C:\\Path\\To\\visioeditor.exe,0"

[HKEY_CURRENT_USER\Software\Classes\VisioEditor.Drawing\shell\open\command]
@="\"C:\\Path\\To\\visioeditor.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\VisioEditor.Drawing.Binary]
@="Visio Binary Drawing"

[HKEY_CURRENT_USER\Software\Classes\VisioEditor.Drawing.Binary\DefaultIcon]
@="C:\\Path\\To\\visioeditor.exe,0"

[HKEY_CURRENT_USER\Software\Classes\VisioEditor.Drawing.Binary\shell\open\command]
@="\"C:\\Path\\To\\visioeditor.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\VisioEditor.Drawio]
@="draw.io Diagram"

[HKEY_CURRENT_USER\Software\Classes\VisioEditor.Drawio\DefaultIcon]
@="C:\\Path\\To\\visioeditor.exe,0"

[HKEY_CURRENT_USER\Software\Classes\VisioEditor.Drawio\shell\open\command]
@="\"C:\\Path\\To\\visioeditor.exe\" \"%1\""

; Modern OPC Visio drawings
[HKEY_CURRENT_USER\Software\Classes\.vsdx]
@="VisioEditor.Drawing"
"Content Type"="application/vnd.ms-visio.drawing"

[HKEY_CURRENT_USER\Software\Classes\.vsdm]
@="VisioEditor.Drawing"
"Content Type"="application/vnd.ms-visio.drawing.macroEnabled.12"

[HKEY_CURRENT_USER\Software\Classes\.vstx]
@="VisioEditor.Drawing"
"Content Type"="application/vnd.ms-visio.template"

[HKEY_CURRENT_USER\Software\Classes\.vstm]
@="VisioEditor.Drawing"
"Content Type"="application/vnd.ms-visio.template.macroEnabled.12"

[HKEY_CURRENT_USER\Software\Classes\.vssx]
@="VisioEditor.Drawing"
"Content Type"="application/vnd.ms-visio.stencil"

[HKEY_CURRENT_USER\Software\Classes\.vssm]
@="VisioEditor.Drawing"
"Content Type"="application/vnd.ms-visio.stencil.macroEnabled.12"

; Legacy binary Visio drawing, stencil, and template
[HKEY_CURRENT_USER\Software\Classes\.vsd]
@="VisioEditor.Drawing.Binary"
"Content Type"="application/vnd.visio"

[HKEY_CURRENT_USER\Software\Classes\.vss]
@="VisioEditor.Drawing.Binary"
"Content Type"="application/vnd.visio"

[HKEY_CURRENT_USER\Software\Classes\.vst]
@="VisioEditor.Drawing.Binary"
"Content Type"="application/vnd.visio"

; Legacy DiagramML XML drawing, stencil, and template
[HKEY_CURRENT_USER\Software\Classes\.vdx]
@="VisioEditor.Drawing.Binary"
"Content Type"="application/vnd.ms-visio.viewer"

[HKEY_CURRENT_USER\Software\Classes\.vsx]
@="VisioEditor.Drawing.Binary"
"Content Type"="application/vnd.visio"

[HKEY_CURRENT_USER\Software\Classes\.vtx]
@="VisioEditor.Drawing.Binary"
"Content Type"="application/vnd.visio"

[HKEY_CURRENT_USER\Software\Classes\.drawio]
@="VisioEditor.Drawio"
"Content Type"="application/vnd.jgraph.mxfile"
